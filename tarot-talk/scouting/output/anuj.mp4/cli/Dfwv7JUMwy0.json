  {
   "from": 18.3,
   "to": 21.3,
   "text": "ब्रो गुगल जैमिनाई लिए लिए लाईप फ्री."
  },
  {
   "from": 21.3,
   "to": 23.3,
   "text": "आप आस गद दे इगल पोस राईप."
  },
  {
   "from": 23.3,
   "to": 26.3,
